package{		import flash.display.BitmapData;	import flash.display.Sprite;	import flash.display.StageAlign;	import flash.display.StageScaleMode;	import flash.events.*;	import flash.geom.*;	import starling.core.*;	import starling.events.ResizeEvent;
		[SWF(frameRate=60, width=960, height=640, backgroundColor="#33CCFF")]		public class CaptainVeggie extends Sprite	{		public var SM:SoundEngine = SoundEngine.getInstance();		public static var MAIN:Object;				public function CaptainVeggie()		{			MAIN = this;			stage.scaleMode = StageScaleMode.NO_SCALE;			stage.align = StageAlign.TOP_LEFT;						var viewPortRectangle:Rectangle = new Rectangle();			viewPortRectangle.width = 960;			viewPortRectangle.height = 640;						Starling.handleLostContext = false;						var star:Starling = new Starling(Game, stage, viewPortRectangle);			star.antiAliasing = 0;			//star.showStats = true;			star.start();						TheAtlasLoader.getInstance().initTheLoader("graphics/imgList.txt");						stage.addEventListener(ResizeEvent.RESIZE, resizeStage);					}				private function resizeStage(e:Event):void		{			var viewPortRectangle:Rectangle = new Rectangle();			viewPortRectangle.width = stage.stageWidth;			viewPortRectangle.height = stage.stageHeight;			Starling.current.viewPort = viewPortRectangle;		}			}}