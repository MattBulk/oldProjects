package com{	import flash.events.Event;	import flash.display.BitmapData;	import flash.display.StageScaleMode;	import flash.display.StageAlign;	import flash.display.Sprite;	import flash.events.*;	import flash.ui.Keyboard;	import flash.geom.Rectangle;	import flash.display.Shape;	import flash.geom.Point;	import fl.data.DataProvider;	import com.interfaces.*;	import com.tools.MarqueeTool;	import fl.controls.TileList;	import flash.events.InvokeEvent;	import flash.desktop.NativeApplication;	import fl.controls.UIScrollBar;	import fl.containers.ScrollPane; 	import fl.controls.ScrollPolicy;	import fl.controls.DataGrid;	import flash.display.MovieClip;	import com.tools.PhysicTool;	public class Main extends Sprite	{		private var iModality:IModality;		private var currentTile:Tile;		//TOOLS		private var marqueeTool:MarqueeTool;		public var physicTool:PhysicTool		//GUI		private var theGui:TheGui;		private var alertPanel:AlertPanel;		private var alertType:uint;		private var scrollPanel:ScrollPane = new ScrollPane();		private var dp:DataProvider = new DataProvider();		private var tileSelected:Shape = new Shape();		public function Main()		{			// constructor code			this.addEventListener(Event.ADDED_TO_STAGE, addedToStage, false, 0, true);						Variables.MAIN = this;						NativeApplication.nativeApplication.addEventListener(InvokeEvent.INVOKE, initializationHandler, false, 0, true);		}				private function initializationHandler(evt:InvokeEvent):void {						if(evt.arguments[0] != undefined) {								Variables.MODALITY = "open";								iModality = new OpenTileSystem();								Variables.FILEHANDLING.startAppFromFile(evt.arguments[0]);				theGui.closeDocu.enabled = true;				theGui.newDocu.enabled = false;				theGui.openDocu.enabled = false;								Variables.DOCUMENTS_CHANGED = false;				Variables.BIG_CONT.addEventListener(MouseEvent.CLICK, checkTile, false, 0, true);			}					}				public function debugs(str:String):void {						debug.text = str;		}		private function addedToStage(evt:Event):void		{			//SET STAGE AND VARS						stage.scaleMode = StageScaleMode.NO_SCALE;			stage.align = StageAlign.TOP_LEFT;			Variables.STAGE_WIDTH = stage.stageWidth;			Variables.STAGE_HEIGHT = stage.stageHeight;						stage.addEventListener(Event.RESIZE, resizeEvent, false, 0, true);						//ADD LAYERS			Variables.BIG_CONT = new Sprite();			this.addChild(Variables.BIG_CONT);						Variables.BACKGROUND_CONT = new Sprite();			Variables.BIG_CONT.addChild(Variables.BACKGROUND_CONT);						Variables.FOREGROUND_CONT = new Sprite();			Variables.BIG_CONT.addChild(Variables.FOREGROUND_CONT);						var mc:MovieClip = new MovieClip();			scrollPanel.setStyle("upSkin", mc);			this.addChild(scrollPanel);						//BLANK TILE;			const loadBitmap:BitmapData = new GreyTile(128, 128);						var obj:Object = new Object();			obj.img_num = "0";			obj.bitmap_data = loadBitmap;						Variables.TILE_BITMAPDATA.push(obj);						//ADD GUI			theGui = new TheGui();			theGui.newPanel.visible = false;			theGui.newPanel.alert.visible = false;						theGui.closeDocu.enabled = false;			theGui.addEventListener(MouseEvent.CLICK, checkGui, false, 0, true);						this.addChild(theGui);						//ADD TOOLS			marqueeTool = new MarqueeTool();			physicTool = new PhysicTool();						//SELECTED TILE			tileSelected.graphics.beginFill(0xFFFF00, .5);			tileSelected.graphics.drawRect(0, 0, 64, 64);			tileSelected.graphics.endFill();			tileSelected.visible = false;						Variables.BIG_CONT.addChild(tileSelected);		}				public function populateScroll():void {						scrollPanel.source = Variables.BIG_CONT; 			scrollPanel.setSize(Variables.STAGE_WIDTH * .997 - theGui.sidePanel.width, Variables.STAGE_HEIGHT); 			scrollPanel.move(0, 0);		}				private function checkData(evt:Event):void {				if(Variables.ALERT_ON) return;						const frame:String = evt.target.selectedItem.source.theCurrentFrame;						evt.target.selectedItem = -1;						Variables.DOCUMENTS_CHANGED = true;						if(Variables.TILE_SELECTED) { 				currentTile.showFrame(frame);				Variables.TILE_SELECTED = false;			}			if(Variables.ACTIVE_MARQUEE) marqueeTool.setTile(frame);		}				//***************************************** EVENT RESIZE ****************************************				private function resizeEvent(e:Event):void {						Variables.BIG_CONT.y = 0;			Variables.STAGE_WIDTH = stage.stageWidth;			Variables.STAGE_HEIGHT = stage.stageHeight;						theGui.x = Variables.STAGE_WIDTH - theGui.sidePanel.width;			theGui.sidePanel.height = Variables.STAGE_HEIGHT;						populateScroll();						theGui.aTl.setSize(220, Variables.STAGE_HEIGHT * .95 - theGui.aTl.y);						if(Variables.ALERT_ON) {								alertPanel.x = Variables.STAGE_WIDTH * .5;				alertPanel.y = Variables.STAGE_HEIGHT * .5;			}		}				//***************************************** INIT THE LIST *************************************				public function populateTheList():void {						Variables.TILES_PATH.splice(0, Variables.TILES_PATH.length);						theGui.aTl.removeAll();						for(var i:uint = 0; i < Variables.TILE_BITMAPDATA.length; i++) {     							var tile:Tile = new Tile();    			tile.showFrame(Variables.TILE_BITMAPDATA[i].img_num);     			dp.addItem( {source:tile} ); 			} 			theGui.aTl.dataProvider = dp;			theGui.aTl.columnWidth = 64; 			theGui.aTl.rowHeight = 64; 			theGui.aTl.setSize(220, Variables.STAGE_HEIGHT * .95 - theGui.aTl.y); 			theGui.aTl.setStyle("contentPadding", 5);			theGui.aTl.addEventListener(Event.CHANGE, checkData, false, 0, true);					}				//***************************************** GUI EVENTS ****************************************				private function checkGui(e:MouseEvent):void {						if(Variables.ALERT_ON) return;						switch (e.target.name) {								case "newDocu":				theGui.newPanel.visible = true;				theGui.newDocu.enabled = false;				break;								case "okNewBtn":				setNewDocument();				break;								case "cancelNewBtn":				theGui.newPanel.rows.text = theGui.newPanel.colums.text = "";				theGui.newPanel.alert.visible = false;				theGui.newPanel.visible = false;				theGui.newDocu.enabled = true;				break;								case "openDocu":				openDocument();				break;								case "closeDocu":				if(Variables.DOCUMENTS_CHANGED) addAlertPanel("Close without saving ?", 0);				else closeDocument();				break;								case "saveDocu":				iModality.saveDocu();				Variables.DOCUMENTS_CHANGED = false;				break;								case "marqueeBtn":				Variables.TILE_SELECTED = false;				Variables.ACTIVE_MARQUEE = theGui.marqueeBtn.selected;				if(Variables.ACTIVE_MARQUEE) marqueeTool.init();				else marqueeTool.remove(); 				break;								case "zoomBtn":				if(theGui.zoomBtn.selected) Variables.BIG_CONT.scaleX = Variables.BIG_CONT.scaleY = .5;				else Variables.BIG_CONT.scaleX = Variables.BIG_CONT.scaleY = 1; 				break;								case "napeBtn":				Variables.TILE_SELECTED = false;				Variables.ACTIVE_NAPETOOL = theGui.napeBtn.selected;				if(Variables.ACTIVE_NAPETOOL) physicTool.init();				else physicTool.remove();				break;								case "addTiles":				Variables.FILEHANDLING.openMultipleFiles();				break;								case "exportBtn":				Variables.MODALITY = "export";				Variables.FILEHANDLING.exportToXML();				break;								case "eraseBtn":				Variables.ACTIVE_ERASER = theGui.eraseBtn.selected;				break;								case "bg_layer":				Variables.BACKGROUND_CONT.visible = theGui.bg_layer.selected;				break;								case "fg_layer":				Variables.FOREGROUND_CONT.visible = theGui.fg_layer.selected;				break;			}		}				//***************************************** DOCUMENT HANDLER ****************************************				private function setNewDocument():void {						if(!theGui.newPanel.rows.text || !theGui.newPanel.colums.text) {								theGui.newPanel.alert.visible = true;				return;			}						iModality = new NewTileSystem();							Variables.ROWS = uint(theGui.newPanel.rows.text);			Variables.COLUMNS = uint(theGui.newPanel.colums.text);			Variables.BIG_CONT.addEventListener(MouseEvent.CLICK, checkTile, false, 0, true);			Variables.BIG_CONT.addEventListener(MouseEvent.MOUSE_OVER, colorTile, false, 0, true);			Variables.BIG_CONT.addEventListener(MouseEvent.MOUSE_OUT, colorTileBack, false, 0, true);			Variables.DOCUMENTS_CHANGED = true;							iModality.init();						theGui.newPanel.visible = false;			theGui.newPanel.alert.visible = false;			theGui.closeDocu.enabled = true;			theGui.addTiles.enabled = true;					}				private function openDocument():void {						iModality = new OpenTileSystem();			iModality.init();							Variables.DOCUMENTS_CHANGED = false;			Variables.BIG_CONT.addEventListener(MouseEvent.CLICK, checkTile, false, 0, true);			Variables.BIG_CONT.addEventListener(MouseEvent.MOUSE_OVER, colorTile, false, 0, true);			Variables.BIG_CONT.addEventListener(MouseEvent.MOUSE_OUT, colorTileBack, false, 0, true);						theGui.closeDocu.enabled = true;			theGui.newDocu.enabled = false;			theGui.openDocu.enabled = false;		}				private function closeDocument():void {						marqueeTool.remove();			physicTool.remove();			iModality.clearContainer();						Variables.MODALITY = "";			Variables.ACTIVE_MARQUEE = false;			Variables.ALREADY_SAVED = false;						Variables.BIG_CONT.removeEventListener(MouseEvent.CLICK, checkTile);			Variables.BIG_CONT.removeEventListener(MouseEvent.MOUSE_OVER, colorTile);			Variables.BIG_CONT.removeEventListener(MouseEvent.MOUSE_OUT, colorTileBack);						Variables.ROWS = Variables.COLUMNS = 0;			Variables.BIG_CONT.x = Variables.BIG_CONT.y = 0;						Variables.TILES_PATH.splice(0, Variables.TILES_PATH.length);			Variables.TILE_BITMAPDATA.splice(1, Variables.TILE_BITMAPDATA.length);							theGui.newPanel.rows.text = theGui.newPanel.colums.text = "";			theGui.aTl.removeAll();			theGui.newDocu.enabled = true;			theGui.openDocu.enabled = true;			theGui.closeDocu.enabled = false;			theGui.marqueeBtn.selected = false;					}				//***************************************** ALERT PANEL ****************************************				public function addAlertPanel(sms:String, type:uint):void {						alertPanel = new AlertPanel();			alertPanel.messages.text = sms;			alertPanel.x = Variables.STAGE_WIDTH * .5;			alertPanel.y = Variables.STAGE_HEIGHT * .5;			alertPanel.addEventListener(MouseEvent.CLICK, alertHandler, false, 0, true); 			this.addChild(alertPanel);						alertType = type;			if(alertType == 1) alertPanel.cancelAlertBtn.visible = false;						Variables.ALERT_ON = true;		}				private function alertHandler(evt:MouseEvent):void {						if(evt.target.name == "okAlertBtn" && alertType == 0) {								closeDocument();				this.removeChild(alertPanel);				alertPanel.removeEventListener(MouseEvent.CLICK, alertHandler);				alertPanel = null;							Variables.ALERT_ON = false;			}			else if(evt.target.name == "cancelAlertBtn" || evt.target.name == "okAlertBtn" && alertType == 1) {								this.removeChild(alertPanel);				alertPanel.removeEventListener(MouseEvent.CLICK, alertHandler);				alertPanel = null;							Variables.ALERT_ON = false;			}								}				//***************************************** CHECK TILE ****************************************		private function checkTile(evt:MouseEvent):void		{						if(Variables.ACTIVE_MARQUEE || Variables.ALERT_ON || Variables.ACTIVE_NAPETOOL || Variables.ACTIVE_ERASER) return;						Variables.TILE_SELECTED = true;						currentTile = evt.target as Tile;						currentTile.stage.focus = currentTile;						tileSelected.visible = false;					}				private function colorTile(evt:MouseEvent):void		{						if(Variables.ACTIVE_MARQUEE || Variables.ALERT_ON || Variables.ACTIVE_NAPETOOL || Variables.ACTIVE_ERASER) return;						tileSelected.graphics.clear();			tileSelected.visible = true;			tileSelected.graphics.moveTo(evt.target.x, evt.target.y);						tileSelected.graphics.beginFill(0xFFFF00, .5);			tileSelected.graphics.drawRect(evt.target.x, evt.target.y, 64, 64);			tileSelected.graphics.endFill();					}				private function colorTileBack(evt:MouseEvent):void		{						if(Variables.ACTIVE_MARQUEE || Variables.ALERT_ON || Variables.ACTIVE_NAPETOOL || Variables.ACTIVE_ERASER) return;						tileSelected.visible = false;					}	}}