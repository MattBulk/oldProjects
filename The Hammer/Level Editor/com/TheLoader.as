package com {		import flash.display.BitmapData;	import flash.events.Event;	import flash.net.URLRequest;	import flash.net.URLLoader;	import flash.events.IOErrorEvent;	import flash.display.Loader;	import flash.system.ImageDecodingPolicy;	import flash.system.LoaderContext;		public class TheLoader {		private var _nextToLoad:uint = 0;		private var _textureLoader:Loader;		private var _obj:Object;		private var _str:String;				public function TheLoader() {			// constructor code		}				public function initTheLoader():void {			             _textureLoader = new Loader();			_textureLoader.addEventListener(IOErrorEvent.IO_ERROR, handleError);			_textureLoader.load(new URLRequest(Variables.TILES_PATH[_nextToLoad]));            _textureLoader.contentLoaderInfo.addEventListener(Event.COMPLETE, onComplete);					Variables.TILES_PATH_TO_SAVE.push(Variables.TILES_PATH[_nextToLoad]);						_obj = new Object();						_str = Variables.TILES_PATH[_nextToLoad].substr(Variables.TILES_PATH[_nextToLoad].length-7, 3);						_obj.img_num = _str;		}				private function onComplete(evt:Event):void		{			const _bitmapData:BitmapData = evt.target.content.bitmapData;						_obj.bitmap_data = _bitmapData; 			Variables.TILE_BITMAPDATA.push(_obj);						_nextToLoad++;						if (_nextToLoad == Variables.TILES_PATH.length) {								_nextToLoad = 0;				Variables.MAIN.populateTheList();				if(Variables.MODALITY == "open") {										Variables.TILESYSTEM.createTiles();					Variables.TILESYSTEM.createBackground();										Variables.MAIN.physicTool.setUpPhysicEngine();									}			}			else {								initTheLoader();			}				}				private function handleError(evt:IOErrorEvent):void {						trace(evt.errorID);		}	}	}