package com.tools {		import flash.geom.Rectangle;	import flash.display.Shape;	import flash.geom.Point;	import flash.events.MouseEvent;	import com.Variables;	import flash.display.Sprite;		public class MarqueeTool {		private var _marquee:Shape = new Shape();		private var _rectMarquee:Rectangle;		private var _startPoint:Point;		private var _selectedTiles:Array;		private var _layer:Sprite;		private var _layerArr:Array;				public function MarqueeTool() {			// constructor code		}				public function init():void {						if(Variables.FOREGROUND_CONT.visible) {				_layer = Variables.FOREGROUND_CONT;				_layerArr = Variables.FOREGROUND_ARRAY;			}			else {				_layer = Variables.BACKGROUND_CONT;				_layerArr = Variables.BACKGROUND_ARRAY;			}						_layer.addEventListener(MouseEvent.MOUSE_DOWN, startTheMarquee, false, 0, true);					}				private function startTheMarquee(evt:MouseEvent):void		{						_startPoint = new Point(evt.currentTarget.mouseX, evt.currentTarget.mouseY);						_selectedTiles = [];						if(_marquee.stage) _layer.removeChild(_marquee);						_layer.addChild(_marquee);						_layer.addEventListener(MouseEvent.MOUSE_MOVE, moveTheMarquee, false, 0, true);			_layer.addEventListener(MouseEvent.MOUSE_UP, stopTheMarquee, false, 0, true);					}				private function moveTheMarquee(evt:MouseEvent):void		{			_marquee.graphics.clear();			_marquee.graphics.lineStyle(1.5, 0xFF0000, 1); 			_marquee.graphics.drawRect(_startPoint.x, _startPoint.y, evt.currentTarget.mouseX - _startPoint.x, evt.currentTarget.mouseY - _startPoint.y); 			_marquee.graphics.endFill();		}				private function stopTheMarquee(evt:MouseEvent):void		{						_rectMarquee = new Rectangle(_startPoint.x, _startPoint.y, evt.currentTarget.mouseX - _startPoint.x, evt.currentTarget.mouseY - _startPoint.y);						checkMarquee();						_layer.removeEventListener(MouseEvent.MOUSE_MOVE, moveTheMarquee);			_layer.removeEventListener(MouseEvent.MOUSE_UP, stopTheMarquee);					}				private function checkMarquee() {						var rect:Rectangle;						for(var t:uint=0; t<_layerArr.length; t++) {								rect = _layerArr[t].getRect(_layer);								if(_rectMarquee.intersects(rect)) _selectedTiles.push(_layerArr[t]);			}					}				public function setTile(frame:String):void {						for(var s:uint=0; s<_selectedTiles.length; s++) _selectedTiles[s].showFrame(frame);					}				public function remove():void {						if(_marquee.stage) _layer.removeChild(_marquee);						if(_layer) _layer.removeEventListener(MouseEvent.MOUSE_DOWN, startTheMarquee);					}	}}