package com.tools{	import flash.geom.Rectangle;	import flash.display.Shape;	import flash.geom.Point;	import flash.events.MouseEvent;	import com.Variables;	public class PhysicTool	{		private var _marquee:Shape;		private var _rectMarquee:Rectangle;		private var _startPoint:Point;		private var _selectedTiles:Array;		private var _marqueeArr:Array = [];		private var _obj:Object;		private var _helpPoint:Point = new Point(0,0);		private var _helpRect:Rectangle;		public function PhysicTool()		{			// constructor code			Variables.FOREGROUND_CONT.addEventListener(MouseEvent.CLICK, removeTheMarquee, false, 0, true);		}		public function init():void		{			Variables.FOREGROUND_CONT.addEventListener(MouseEvent.MOUSE_DOWN, startTheMarquee, false, 0, true);		}		private function startTheMarquee(evt:MouseEvent):void		{			_startPoint = new Point(evt.currentTarget.mouseX,evt.currentTarget.mouseY);			_marquee = new Shape();			_marquee.graphics.moveTo(_startPoint.x, _startPoint.y);			_selectedTiles = [];			Variables.FOREGROUND_CONT.addChild(_marquee);			Variables.FOREGROUND_CONT.addEventListener(MouseEvent.MOUSE_MOVE, moveTheMarquee, false, 0, true);			Variables.FOREGROUND_CONT.addEventListener(MouseEvent.MOUSE_UP, stopTheMarquee, false, 0, true);					}		private function moveTheMarquee(evt:MouseEvent):void		{			if (Variables.ACTIVE_ERASER)			{				return;			}			_marquee.graphics.clear();			_marquee.graphics.beginFill(0x00FF00, .3);			_marquee.graphics.drawRect(_startPoint.x, _startPoint.y, evt.currentTarget.mouseX - _startPoint.x, evt.currentTarget.mouseY - _startPoint.y);			_marquee.graphics.endFill();		}		private function stopTheMarquee(evt:MouseEvent):void		{			if (Variables.ACTIVE_ERASER)			{				return;			}			_rectMarquee = new Rectangle(_startPoint.x,_startPoint.y,evt.currentTarget.mouseX - _startPoint.x,evt.currentTarget.mouseY - _startPoint.y);			_obj = new Object();			_obj.sprite = _marquee;			checkMarquee();			Variables.FOREGROUND_CONT.removeEventListener(MouseEvent.MOUSE_MOVE, moveTheMarquee);			Variables.FOREGROUND_CONT.removeEventListener(MouseEvent.MOUSE_UP, stopTheMarquee);		}		private function checkMarquee():void		{			var num:uint = 0;			var objectsIndex:uint;			var dir:String,str:String,type:String;			for (var t:uint=0; t<=Variables.FOREGROUND_ARRAY.length-1; t++)			{				_helpRect = Variables.FOREGROUND_ARRAY[t].getRect(Variables.FOREGROUND_CONT);				if (_rectMarquee.intersects(_helpRect))				{					_selectedTiles.push(Variables.FOREGROUND_ARRAY[t]);					if (num == 0)					{						objectsIndex = Variables.FOREGROUND_ARRAY.indexOf(Variables.FOREGROUND_ARRAY[t]);						type = Variables.FOREGROUND_ARRAY[t].theCurrentFrame;						type = type.charAt(type.length -1);					}					num++;				}			}			if (_selectedTiles[0].y == _selectedTiles[1].y)			{				dir = "H";			}			else			{				dir = "V";			}			str = num.toString() + dir + type;			Variables.PHYSIC_ARRAY[objectsIndex] = str;			_obj.objIndex = objectsIndex;			_marqueeArr.push(_obj);		}		private function removeTheMarquee(evt:MouseEvent):void		{			_helpPoint.setTo(evt.currentTarget.mouseX, evt.currentTarget.mouseY);			for (var m:uint=0; m<_marqueeArr.length; m++)			{				_helpRect = _marqueeArr[m].sprite.getRect(Variables.FOREGROUND_CONT);				if (_helpRect.containsPoint(_helpPoint))				{					Variables.FOREGROUND_CONT.removeChild(_marqueeArr[m].sprite);					Variables.PHYSIC_ARRAY[_marqueeArr[m].objIndex] = 0;					_marqueeArr.splice(m, 1);				}			}		}		public function setUpPhysicEngine():void		{			var num:uint = 0;			for (var X:uint=0; X<Variables.ROWS; X++)			{				for (var Y:uint=0; Y<Variables.COLUMNS; Y++)				{					if (Variables.PHYSIC_ARRAY[num] != 0)					{						_obj = new Object();						_obj.objIndex = num;						decodeString(X, Y, Variables.PHYSIC_ARRAY[num]);					}					num++;				}			}		}		private function decodeString(pX:uint, pY:uint, str:Object):void		{			const cbType:String = str.charAt(str.length - 1);			const direct:String = str.charAt(str.length - 2);			const bodyLength:String = str.slice(0,str.length - 2);			switch (cbType)			{				case "p" :					addPlatform(pX, pY, uint(bodyLength));					break;				case "w" :					addWall(pX, pY, uint(bodyLength), direct);					break;			}		}		private function addPlatform(pX:uint, pY:uint, num:uint):void		{			_marquee = new Shape();						_marquee.graphics.beginFill(0x00FF00, .3);			_marquee.graphics.drawRect(pX * 64 + 32, pY * 64 + 16, 64 * (num-1), 32);			_marquee.graphics.endFill();						_obj.sprite = _marquee;						_marqueeArr.push(_obj);						Variables.FOREGROUND_CONT.addChild(_marquee);		}				private function addWall(pX:uint, pY:uint, num:uint, direct:String):void		{			_marquee = new Shape();						_marquee.graphics.beginFill(0x00FF00, .3);			if(direct == "H") _marquee.graphics.drawRect(pX * 64 + 32, pY * 64 + 16, 64 * (num-1), 32);			else _marquee.graphics.drawRect(pX * 64 + 16, pY * 64 + 32, 32, 64 * (num-1));			_marquee.graphics.endFill();						_obj.sprite = _marquee;						_marqueeArr.push(_obj);						Variables.FOREGROUND_CONT.addChild(_marquee);		}		public function setTile(frame:uint):void		{			for (var s:uint=0; s<=_selectedTiles.length-1; s++)			{				_selectedTiles[s].showFrame(frame);			}		}		public function remove():void		{			for (var m:uint=0; m<=_marqueeArr.length-1; m++)			{				Variables.FOREGROUND_CONT.removeChild(_marqueeArr[m].sprite);			}			_marqueeArr.splice(0, _marqueeArr.length);			Variables.FOREGROUND_CONT.removeEventListener(MouseEvent.MOUSE_DOWN, startTheMarquee);			Variables.FOREGROUND_CONT.removeEventListener(MouseEvent.CLICK, removeTheMarquee);		}	}}