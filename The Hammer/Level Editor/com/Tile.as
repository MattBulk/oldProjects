package com {		import flash.display.Sprite;	import flash.display.Bitmap;		public class Tile extends Sprite {		public var theCurrentFrame:String;		public var bitmap:Bitmap;				public function Tile() {			// constructor code			bitmap = new Bitmap(Variables.TILE_BITMAPDATA[0].bitmap_data);						theCurrentFrame = Variables.TILE_BITMAPDATA[0].img_num;						this.addChild(bitmap);		}				public function showFrame(frame:String):void {						var index:uint;						for(var i:uint=0; i < Variables.TILE_BITMAPDATA.length; i++) {								if(Variables.TILE_BITMAPDATA[i].img_num == frame) index = i;			}						bitmap.bitmapData = Variables.TILE_BITMAPDATA[index].bitmap_data;			theCurrentFrame = Variables.TILE_BITMAPDATA[index].img_num;					}			}	}