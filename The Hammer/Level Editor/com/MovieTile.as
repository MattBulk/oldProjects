package com{	import flash.display.Sprite;	import flash.display.BitmapData;	import flash.display.Bitmap;	public class MovieTile extends Sprite	{		public var totalFrame:uint = Variables.TILE_BITMAPDATA.length; 		public var theLabel:String;		public var theCurrentFrame:uint;				public function MovieTile():void		{			for (var b:uint=0; b<Variables.TILE_BITMAPDATA.length; b++)			{				const bmVis:Bitmap = new Bitmap(Variables.TILE_BITMAPDATA[b]);								this.addChildAt(bmVis, b);								bmVis.visible = false;			}		}		public function showFrame(num:uint):void		{			for (var i:int = 0; i < this.numChildren; i++)			{				if (i == num)				{					this.getChildAt(i).visible = true;				}				else				{					this.getChildAt(i).visible = false;				}			}						theCurrentFrame = Variables.TILE_IMG_NUM[num];			theLabel = Variables.TILE_TYPE[num];		}	}}