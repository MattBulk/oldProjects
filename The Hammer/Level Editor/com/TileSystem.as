package com{	import flash.display.Sprite;		public class TileSystem	{		private var tile:Tile;		public function TileSystem():void		{			// constructor code		}				public function createTiles():void		{			// constructor code			Variables.FOREGROUND_ARRAY = [];			var num:int = 0;			for (var X:uint=0; X<Variables.ROWS; X++)			{				for (var Y:uint=0; Y<Variables.COLUMNS; Y++)				{					tile = new Tile();					tile.width = tile.height = 64;					tile.x = X * tile.width;					tile.y = Y * tile.height;					tile.alpha = 2;										if(Variables.TILE_SET[num] == undefined) tile.showFrame("0");					else tile.showFrame(Variables.TILE_SET[num]);										Variables.FOREGROUND_CONT.addChild(tile);					Variables.FOREGROUND_ARRAY.push(tile);										num++;				}			}						Variables.MAIN.populateScroll();						if(Variables.MODALITY != "open") for(var i:int=0; i < Variables.FOREGROUND_ARRAY.length; i++) Variables.PHYSIC_ARRAY.push(0);		}				public function createBackground():void {						Variables.BACKGROUND_ARRAY = [];			var num:int = 0;			for (var X:uint=0; X<Variables.ROWS; X++)			{				for (var Y:uint=0; Y<Variables.COLUMNS; Y++)				{					tile = new Tile();					tile.width = tile.height = 64;					tile.x = X * tile.width;					tile.y = Y * tile.height;					tile.alpha = 2;										if(Variables.TILE_SET2[num] == undefined) tile.showFrame("0");					else tile.showFrame(Variables.TILE_SET2[num]);										Variables.BACKGROUND_CONT.addChild(tile);					Variables.BACKGROUND_ARRAY.push(tile);					num++;				}			}		}				public function clearContainer():void {						for (var i:int = Variables.FOREGROUND_CONT.numChildren-1; i >= 0; i--) {   								Variables.FOREGROUND_CONT.removeChildAt(i);				Variables.BACKGROUND_CONT.removeChildAt(i);							}						Variables.TILE_SET.splice(0, Variables.TILE_SET.length);			Variables.TILE_SET2.splice(0, Variables.TILE_SET2.length);		}	}}