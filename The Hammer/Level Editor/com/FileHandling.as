package com {		import flash.filesystem.*;	import flash.events.Event;	import flash.net.FileFilter;	import flash.events.IOErrorEvent;	import flash.events.ProgressEvent;	import flash.events.OutputProgressEvent;	import flash.events.FileListEvent;	import flash.display.Bitmap;	import flash.display.BitmapData;	import flash.utils.ByteArray;		public class FileHandling {		private var _stream:FileStream;		private var _theFile:File = new File();		private var _xml_data:XML;		private var _completeUrl:String;				public function FileHandling() {			// constructor code		}				public function openFile():void {						const txtFilter:FileFilter = new FileFilter("File", "*.hammer");    		_theFile.browseForOpen("Open", [txtFilter]);						Variables.MODALITY = "open";						addFileListeners();					}				public function openMultipleFiles():void {						_theFile.browseForOpenMultiple("Select Files");			_theFile.addEventListener(FileListEvent.SELECT_MULTIPLE, multiplefilesSelected, false, 0, true);			_theFile.addEventListener(Event.CANCEL, canceledList, false, 0, true);		}				public function startAppFromFile(str:String):void {						_theFile = new File(str);						openTheStream();						_stream.open(_theFile, FileMode.READ);    					const fileData:String = _stream.readUTFBytes(_stream.bytesAvailable);    					initTheLevel(fileData);						closeTheStream();		}				public function createTheXML():void {						_xml_data = <world>  						<room>    						<rows></rows>    						<columns></columns>    						<foregroundType></foregroundType>							<backgroundType></backgroundType>							<physicType></physicType>							<marqueeType></marqueeType>							<tilePath></tilePath>  						</room>					   </world>						_xml_data.room.rows = Variables.ROWS;			_xml_data.room.columns = Variables.COLUMNS;		}				public function saving():void {						var stringArr:Array = [];			var str:String;						for (var f:uint=0; f<=Variables.FOREGROUND_ARRAY.length-1; f++)			{				str = Variables.FOREGROUND_ARRAY[f].theCurrentFrame;				stringArr.push(str);			}						_xml_data.room.foregroundType = stringArr.toString();						stringArr.splice(0, stringArr.length);						for (var b:uint=0; b<=Variables.BACKGROUND_ARRAY.length-1; b++)			{				str = Variables.BACKGROUND_ARRAY[b].theCurrentFrame;				stringArr.push(str);			}						trace(Variables.TILES_PATH);						_xml_data.room.backgroundType = stringArr.toString();			_xml_data.room.tilePath = Variables.TILES_PATH_TO_SAVE;			_xml_data.room.physicType = Variables.PHYSIC_ARRAY;						if(Variables.ALREADY_SAVED) writeXML(_xml_data);						else {				addFileListeners();				_theFile.save(_xml_data, ".hammer");			}		}				public function exportToXML():void {						var stringArr:Array = [];			var str:String;						for (var t:uint=0; t<=Variables.FOREGROUND_ARRAY.length-1; t++)			{				str = Variables.FOREGROUND_ARRAY[t].theCurrentFrame;				stringArr.push(str);			}						const foregroundType:String = stringArr.toString();						var xml_export:XML = _xml_data;						xml_export.room.foregroundType = foregroundType;			xml_export.room.physicType = Variables.PHYSIC_ARRAY;						delete xml_export.room.tilePath;						addFileListeners();						_theFile.save(xml_export, ".xml");		}				private function writeXML(theData:String):void {						_theFile.resolvePath(_completeUrl);						openTheStream();						_stream.open(_theFile, FileMode.WRITE);			_stream.writeUTFBytes(theData);						closeTheStream();		}				private function initTheLevel(xml_file:String):void {			_xml_data = XML(xml_file);						Variables.ROWS = _xml_data.room.rows;			Variables.COLUMNS = _xml_data.room.columns;            const tileSet:String = _xml_data.room.foregroundType;            Variables.TILE_SET = tileSet.split(",");						const tileSet2:String = _xml_data.room.backgroundType;            Variables.TILE_SET2 = tileSet2.split(",");						const tilePath:String = _xml_data.room.tilePath;			Variables.TILES_PATH = tilePath.split(",");						const physicType:String = _xml_data.room.physicType;			Variables.PHYSIC_ARRAY = physicType.split(",");						Variables.THELOADER.initTheLoader();        }				//***************************************** STREAM LISTENERS **********************************				private function openTheStream():void {						_stream = new FileStream();		}				private function closeTheStream():void {						_stream.close();		}				//***************************************** FILE LISTENERS ************************************				private function addFileListeners():void {						_theFile.addEventListener(Event.SELECT, fileSelected, false, 0, true);			_theFile.addEventListener(IOErrorEvent.IO_ERROR, handleError, false, 0, true);			_theFile.addEventListener(Event.COMPLETE, savedCompleted, false, 0, true);		}				private function removeFileListeners():void {						_theFile.removeEventListener(Event.SELECT, fileSelected);			_theFile.removeEventListener(IOErrorEvent.IO_ERROR, handleError);			_theFile.removeEventListener(Event.COMPLETE, savedCompleted);		}				//***************************************** FILE EVENTS ****************************************				private function handleError(evt:IOErrorEvent):void {						Variables.MAIN.addAlertPanel("Please selected the complete path before saving", 1);			closeTheStream();		}				private function fileSelected(evt:Event):void 		{			if(Variables.MODALITY != "open") {								_completeUrl = evt.target.url;				Variables.MODALITY = "save";			}						else {								_theFile = evt.target as File;								_completeUrl = _theFile.url;							openTheStream();							_stream.open(_theFile, FileMode.READ);    						const fileData:String = _stream.readUTFBytes(_stream.bytesAvailable);    						initTheLevel(fileData);							closeTheStream();			}					}				private function savedCompleted(evt:Event):void {						removeFileListeners();			if(Variables.MODALITY != "export") Variables.ALREADY_SAVED = true;			Variables.MODALITY != "";		}				private function multiplefilesSelected(evt:FileListEvent):void 		{    		for (var i:uint = 0; i < evt.files.length; i++)     		{				Variables.TILES_PATH.push(evt.files[i].url);				Variables.TILES_PATH_TO_SAVE.push(evt.files[i].url);    		}						Variables.THELOADER.initTheLoader();					}				private function canceledList(evt:Event):void {						trace("CANCELED");		}	}	}